# Copy to ~/.config/backrest/hooks/.env and fill in real values
# (instance hooks live next to backup.json; the checkout hooks/ is a legacy fallback)

# Immich dump (hooks/immich-dump.sh)
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=your-api-key
# IMMICH_CONTAINER=immich_server
# IMMICH_UPLOAD_DIR=/mnt/ssd/media/immich

# MinIO stop/start (hooks/minio-stop.sh, hooks/minio-start.sh)
# MINIO_CONTAINER=minio

# NOTE: credentials for remote restic repos (S3/B2) do NOT belong here.
# Put them in the env_file referenced by the profile in backup.json, e.g.
# ~/.config/backrest/b2.env:
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=eu-central-003

# Forgejo dump (hooks/forgejo-dump.sh)
# FORGEJO_CONTAINER=forgejo
# FORGEJO_DATA_DIR=/data
# FORGEJO_DUMP_SUBDIR=backups
# FORGEJO_KEEP_DUMPS=5
