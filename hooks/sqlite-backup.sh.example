#!/usr/bin/env bash
#
# prehook: consistent snapshots of live SQLite databases using the online
# backup API (`.backup`), which is safe while a database is in use and
# includes committed WAL contents.
#
# This hook only READS live databases. It never writes to them and never
# stops/starts services, so nothing needs a restart and no live file is
# touched. Dumps are written inside the tree they belong to, at
# <root>/_sqlite-dumps/<relative path>, so the regular profile for that tree
# (e.g. homelab-data, web-data) contains configs and consistent databases in
# one snapshot. Databases outside any configured root fall back to
# SQLITE_DUMP_DIR.
#
# Config: ~/.config/backrest/sqlite-dbs.conf (see README). Each line is:
#   - a directory: scanned recursively for *.db / *.sqlite / *.sqlite3; its
#     dumps go to <dir>/_sqlite-dumps/
#   - a file or glob: dumped as-is (fallback location)
#   - !pattern: exclude paths matching the fnmatch pattern
# Only files whose header is a real SQLite database are dumped. Existing
# _sqlite-dumps directories are ignored during discovery (never re-dumped).
# `sqlite-backup.sh --list` prints the databases that would be dumped.

set -euo pipefail

CONF="${SQLITE_DBS_CONF:-$HOME/.config/backrest/sqlite-dbs.conf}"
DUMP_DIR="${SQLITE_DUMP_DIR:-$HOME/.local/share/backrest/sqlite-dumps}"
LIST_ONLY=false
[[ "${1:-}" == "--list" ]] && LIST_ONLY=true

if [[ ! -f "$CONF" ]]; then
    echo "sqlite-backup: no DB list at $CONF"
    exit 1
fi
if ! command -v sqlite3 >/dev/null; then
    echo "sqlite-backup: sqlite3 not found"
    exit 1
fi

# ---- config -----------------------------------------------------------------

entries=() roots=() excludes=()
while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" == \!* ]]; then
        excludes+=("${line#!}")
    else
        entries+=("$line")
        [[ -d "$line" ]] && roots+=("$line")
    fi
done < "$CONF"

# Longest root first so nested mappings pick the most specific root.
if [[ ${#roots[@]} -gt 1 ]]; then
    mapfile -t roots < <(printf '%s\n' "${roots[@]}" | awk '{ print length, $0 }' | sort -rn | cut -d' ' -f2-)
fi

# ---- discovery --------------------------------------------------------------

declare -A seen=()
dbs=()

add_candidate() {
    local f="$1" ex magic=""
    [[ -f "$f" ]] || return 0
    [[ "$f" == */_sqlite-dumps/* ]] && return 0
    for ex in "${excludes[@]}"; do
        # shellcheck disable=SC2053  # right-hand side is an fnmatch pattern
        [[ "$f" == $ex ]] && return 0
    done
    [[ -n "${seen[$f]:-}" ]] && return 0
    seen[$f]=1
    # SQLite files start with "SQLite format 3\0"; this filters WAL/SHM,
    # non-SQLite .db files, celery shelve files, etc.
    IFS= read -r -n 15 magic < "$f" 2>/dev/null || true
    [[ "$magic" == "SQLite format 3" ]] || return 0
    dbs+=("$f")
}

for entry in "${entries[@]}"; do
    if [[ -d "$entry" ]]; then
        while IFS= read -r f; do
            add_candidate "$f"
        done < <(find "$entry" -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \) 2>/dev/null)
    else
        # shellcheck disable=SC2206  # glob expansion is intended
        for f in $entry; do
            add_candidate "$f"
        done
    fi
done

mapfile -t dbs < <(printf '%s\n' "${dbs[@]}" | sort)

if [[ ${#dbs[@]} -eq 0 ]]; then
    echo "sqlite-backup: no databases found (check $CONF)"
    exit 1
fi

if [[ "$LIST_ONLY" == true ]]; then
    printf '%s\n' "${dbs[@]}"
    exit 0
fi

# ---- dump -------------------------------------------------------------------

# Dump destination for a database: inside its tree's _sqlite-dumps/ sidecar
# when it belongs to a configured root, otherwise the fallback staging dir.
dump_target() {
    local db="$1" root
    for root in "${roots[@]}"; do
        if [[ "$db" == "$root/"* ]]; then
            printf '%s\n' "$root/_sqlite-dumps/${db#"$root/"}"
            return 0
        fi
    done
    printf '%s\n' "$DUMP_DIR$db"
}

# status file that sits next to a dump target
target_status() {
    local target="$1"
    case "$target" in
        */_sqlite-dumps/*) printf '%s\n' "${target%%/_sqlite-dumps/*}/_sqlite-dumps/_status.txt" ;;
        *)                 printf '%s\n' "$DUMP_DIR/_status.txt" ;;
    esac
}

# start from a clean slate for every destination
for root in "${roots[@]}"; do
    rm -rf "$root/_sqlite-dumps"
    mkdir -p "$root/_sqlite-dumps"
done
rm -rf "$DUMP_DIR"
mkdir -p "$DUMP_DIR"

# `.backup` opens the source database, and opening a WAL-mode database
# read-write needs write access (to create the -shm file). Databases owned by
# another service user (e.g. media-manager) are retried via passwordless sudo
# when available; the dump itself lands in a directory we own.
dump_one() {
    local db="$1" tmp="$2" status="$3"
    sqlite3 "$db" ".timeout 5000" ".backup '$tmp'" >>"$status" 2>&1 && return 0
    if [[ ! -w "$db" ]] && sudo -n true 2>/dev/null; then
        echo "note: $db not writable by $(id -un); retrying via sudo" >> "$status"
        sudo -n sqlite3 "$db" ".timeout 5000" ".backup '$tmp'" >>"$status" 2>&1 && return 0
    fi
    return 1
}

ok=0 fail=0

for db in "${dbs[@]}"; do
    dest="$(dump_target "$db")"
    status="$(target_status "$dest")"
    mkdir -p "$(dirname "$dest")"
    : >> "$status"
    if dump_one "$db" "$dest.tmp" "$status" && mv "$dest.tmp" "$dest"; then
        if [[ "$(sqlite3 "$dest" "PRAGMA quick_check;" 2>/dev/null)" == "ok" ]]; then
            echo "ok   $db" >> "$status"
            ok=$((ok + 1))
        else
            echo "FAIL $db (quick_check)" | tee -a "$status"
            rm -f "$dest"
            fail=$((fail + 1))
        fi
    else
        echo "FAIL $db (backup error, see log above)" | tee -a "$status"
        rm -f "$dest.tmp"
        fail=$((fail + 1))
    fi
done

echo "sqlite-backup: $ok ok, $fail failed; discovered ${#dbs[@]}; dumps under: ${roots[*]:-}${roots[*]:+ }$DUMP_DIR"
[[ $fail -eq 0 ]]
