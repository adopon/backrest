{
  "$schema": "./backup.schema.json",
  "log_dir": "$HOME/.local/log/backrest",
  "log_retention_days": 30,
  "paths": {
    "fast": "/mnt/ssd",
    "storage": "/mnt/hdd",
    "home": "/home/youruser"
  },
  "global": {
    "restic_password_file": "~/.config/backrest/restic-password"
  },
  "profiles": {
    "photos": {
      "enabled": true,
      "type": "restic",
      "src": "${fast}/media/photos",
      "repo": "${storage}/backrest/photos",
      "retention": "keep-daily 7 keep-weekly 4 keep-monthly 6",
      "require_mount": "${storage}"
    },
    "photos-offsite": {
      "enabled": false,
      "type": "restic",
      "src": "${fast}/media/photos",
      "repo": "s3:https://s3.eu-central-003.backblazeb2.com/my-restic-bucket/photos",
      "retention": "keep-daily 7 keep-weekly 4 keep-monthly 12",
      "env_file": "~/.config/backrest/b2.env",
      "flags": ["--limit-upload", "8000"]
    },
    "documents": {
      "enabled": true,
      "type": "rsync",
      "src": "${home}/documents",
      "dest": "${storage}/backup/documents"
    },
    "myapp-db": {
      "enabled": true,
      "type": "sqlite",
      "src": "/srv/myapp/data.db",
      "repo": "${storage}/backrest/db/myapp",
      "retention": "keep-daily 7 keep-weekly 4 keep-monthly 6"
    },
    "sqlite-dumps": {
      "enabled": false,
      "type": "restic",
      "src": "${home}/.local/share/backrest/sqlite-dumps",
      "repo": "${storage}/backrest/sqlite-dumps",
      "retention": "keep-daily 14 keep-weekly 8 keep-monthly 12",
      "prehook": "${home}/.config/backrest/hooks/sqlite-backup.sh"
    },
    "photos-cloud": {
      "enabled": false,
      "type": "s3",
      "src": "${fast}/media/photos",
      "dest": "backup-bucket:backups/photos",
      "exclude": ["thumbs/", "*.tmp"]
    }
  }
}
